{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": ".claude/hooks/session-start.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/post-tool-use-log-activity.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": ".claude/hooks/stop-suggest-record.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash .agents/skills/*/scripts/*.sh *)",
      "Bash(bash .agents/skills/project-setup/scripts/validate.sh)"
    ]
  }
}
