{
  "name": "cursor-knowledge-management-system",
  "private": true,
  "type": "module",
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "markdown-link-check": "^3.15.0",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "skills:check": "node scripts/check-skill-structure.mjs",
    "components:check": "node scripts/check-components.mjs",
