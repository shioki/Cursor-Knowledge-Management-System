# Cursor Knowledge Management System — リポジトリ用 .gitignore
# 利用側プロジェクト向けの除外例は templates/.cursorignore を参照してください。

# 依存関係・ビルド成果物
node_modules/
dist/
build/
*.pyc
__pycache__/

# dogfooding 用のローカル導入。スキルは init.sh で作り直せるが、中の開発記録
# （decisions/ patterns/ improvements/）は作り直せない。削除しないこと。
.agents/
# dogfooding の init.sh . がリポジトリ直下に置く .cursorignore
/.cursorignore

# hooks が生成する活動ログ・ローカル設定
knowledge-activity.log
knowledge-hooks.conf
.cursor/hooks/
.cursor/agents/

# 環境設定ファイル（機密情報含む）
.env
.env.local
.env.production
.env.staging

# ログ・一時ファイル
logs/
*.log
tmp/
temp/
.tmp/
*.bak
*~
*.tmp

# OS 固有ファイル
.DS_Store
Thumbs.db
desktop.ini

# エディタ固有ファイル
.vscode/settings.json
.idea/
*.swp
*.swo
